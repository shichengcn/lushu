{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lushu",
  "main": "./worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SHARES",
      "id": "7ff9bccef57545b78e13a0da4be7e305"
    }
  ]
}
